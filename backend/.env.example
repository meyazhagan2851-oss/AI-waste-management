# ==========================================
# AI Smart Waste Management System - Backend Environment Variables
# Copy this file to ".env" and update values as needed
# ==========================================

# Application
APP_NAME=AI Smart Waste Management System
APP_ENV=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# CORS - comma separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (SQLite by default - no setup required)
DATABASE_URL=sqlite:///./waste_management.db

# If using MongoDB instead, uncomment and set:
# DATABASE_TYPE=mongodb
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB_NAME=waste_management

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# AI Model
MODEL_PATH=ai_model/saved_model/waste_classifier.h5
MODEL_INPUT_SIZE=224
CONFIDENCE_THRESHOLD=0.5

# Alert Settings
FULL_BIN_ALERT_ENABLED=True
